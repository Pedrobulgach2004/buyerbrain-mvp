          }
        ],
        [
          {
            "node": "Responder permiso inválido",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Telegram: enviar promoción": {
      "main": [
        [
          {
            "node": "Supabase: confirmar enviado",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Supabase: registrar fallo",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Supabase: confirmar enviado": {
      "main": [
        [
          {
            "node": "Responder OK",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Supabase: registrar fallo": {
      "main": [
        [
          {
            "node": "Responder fallo Telegram",
