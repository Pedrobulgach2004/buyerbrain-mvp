# Copiá este archivo como .env.local y reemplazá los valores de ejemplo.
# Estos datos pueden usarse en el navegador porque el acceso real está protegido por RLS.
VITE_SUPABASE_URL=https://tu-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_tu_clave_publica

# Datos públicos del canal. El token secreto del bot se configura únicamente en n8n.
VITE_TELEGRAM_BOT_USERNAME=buyerbrain_demo_bot
VITE_N8N_TELEGRAM_WEBHOOK_URL=https://tu-n8n.example/webhook/buyerbrain-telegram-send

# Nunca agregues SUPABASE_SERVICE_ROLE_KEY ni otros secretos privados al frontend.
